@model RentCar.Models.Response.PaginationBaseResponse<RentCar.Models.Entity.CarEntity>

@* @{
    // --- Pagination Truncation Logic ---
    // This C# block calculates which pages and ellipses to show.

    // How many pages to show around the current page (e.g., 1 ... 3 4 [5] 6 7 ... 10)
    const int pagesAroundCurrent = 2;

    var pageNumbers = Enumerable.Range(1, Model.TotalPages).ToList();
    var pagesToShow = new List<object>();

    if (pageNumbers.Count > 0)
    {
        pagesToShow.Add(1); // Always show page 1

        var needsLeadingEllipsis = Model.PageNumber > pagesAroundCurrent + 2;
        if (needsLeadingEllipsis)
        {
            pagesToShow.Add("..."); // Ellipsis
        }

        // Add pages around the current one
        var start = Math.Max(2, Model.PageNumber - pagesAroundCurrent);
        var end = Math.Min(Model.TotalPages - 1, Model.PageNumber + pagesAroundCurrent);

        if (needsLeadingEllipsis) start = Math.Max(start, 2); // Start from 2 if ellipsis shown

        for (var i = start; i <= end; i++)
        {
            pagesToShow.Add(i);
        }

        var needsTrailingEllipsis = Model.PageNumber < Model.TotalPages - pagesAroundCurrent - 1;
        if (needsTrailingEllipsis && Model.TotalPages > end)
        {
            pagesToShow.Add("..."); // Ellipsis
        }

        // Always show last page if it hasn't been added and TotalPages > 1
        if (Model.TotalPages > 1 && pagesToShow.LastOrDefault() is int lastPage && lastPage < Model.TotalPages)
        {
            pagesToShow.Add(Model.TotalPages);
        }

        // Clean up: Remove consecutive duplicates and ensure the list only contains ints and '...'
        pagesToShow = pagesToShow.Distinct().ToList();

        // A final cleanup for edge cases like 1 ... 3 4 5 ... 8 where '1' is too close to '3'
        // This is complex, but for simplicity, we rely on the above logic being close enough.
    }
} *@

@* car list grid *@
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 mt-6">
    @foreach (var car in Model.Items)
    {
        <div class="col-start-start pb-2 h-full rounded-xl overflow-hidden bg-white shadow-sm transition-shadow hover:shadow-lg">
            <div
                class="w-full bg-center bg-no-repeat aspect-video bg-cover"
                data-alt="White Tesla Model 3 sedan"
                style="
                                            background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCW6INcRMw_wG2LVAX_muXNodnrR2aOMc9ywvh0x1O-IO_UFtVJ3CRkR7EtskAKYq7Vv2smKPPZO6xRWrW5qlSqMTZHR1YG9whGLjLbI1OVYwKuUkpFU8Dk-2nVV7074ULaS8JUq36BZ-znLLGOjYfSTQ7jNApdcv93RwUBKap961dCLrMzuDGVYCxBbrEROHQ0lFotDpriOgtEQoYLM60uba7ncC_MMViRyMvP6CWZ7LaSSxg93TXsHyek-1CG41GTwdrhIvwhKEoL');
                                        ">
            </div>
            <div class="col-start-start px-4 w-full">
                <p class="text-lg mt-3 text-vulcan">@car.Brand</p>
                <p class="text-sm text-pale-sky">EV, Automatic, 4 Seats</p>
                <div class="flex mt-4 flex-row w-full items-center gap-2">
                    <p class="text-[16px] flex-1 line-clamp-1 text-vulcan">Rp @car.RentalRatePerDay<span class="text-sm text-pale-sky">/day</span></p>
                    <div class="primary-button line-clamp-1 py-2">
                        Rent Now
                    </div>
                </div>
            </div>
        </div>
    }
</div>

