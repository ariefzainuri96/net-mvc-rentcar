@* pagination *@
<div class="flex flex-row justify-center mt-4">
    <ul class="flex flex-row space-x-2">
        @if (Model.HasPreviousPage)
        {
            <li>
                <a href="#" class="pagination-link size-10 flex justify-center items-center rounded-lg text-river-bed bg-athens-gray-200" data-page="@(Model.PageNumber - 1)">
                    <i class=" fa-solid fa-chevron-left"></i>
                </a>
            </li>
        }

        @for (var i = 1; i <= Model.TotalPages; i++)
        {
            <li>
                <a href="#" class="pagination-link size-10 flex justify-center items-center rounded-lg @(i == Model.PageNumber ? "bg-denim text-white" : "text-river-bed bg-athens-gray-200")" data-page="@i">@i</a>
            </li>
        }

        @if (Model.HasNextPage)
        {
            <li>
                <a href="#" class="pagination-link size-10 flex justify-center items-center rounded-lg text-river-bed bg-athens-gray-200" data-page="@(Model.PageNumber + 1)">
                    <i class="fa-solid fa-chevron-right"></i>
                </a>
            </li>
        }
    </ul>
</div>